#!/usr/bin/env python3
"""Print a password from ~/.authinfo or ~/.netrc for machine/login[/port].

Filename: authinfo-pass
Description: Extract one authinfo/netrc password for mbsync/sendmail PassCmd
Author: SCS
Copyright: Copyright (C) 2026, SCS, all rights reserved.
Created: 2026-07-20 Mon 17:44
Version: 0.2.1
Last-Updated: 2026-07-20 Mon 19:01
Update #: 2

Usage:
  authinfo-pass MACHINE LOGIN [PORT]
  authinfo-pass --list
"""
from __future__ import annotations

import sys
from pathlib import Path

KEYS = ("machine", "login", "port", "password", "account")


def parse_tokens(parts: list[str]) -> dict[str, str]:
    data: dict[str, str] = {}
    i = 0
    while i < len(parts):
        key = parts[i].lower()
        if key in KEYS and i + 1 < len(parts):
            data[key] = parts[i + 1]
            i += 2
            continue
        i += 1
    return data


def load_entries(path: Path) -> list[dict[str, str]]:
    """Parse authinfo/netrc one-line and multi-line entries."""
    entries: list[dict[str, str]] = []
    current: dict[str, str] = {}

    def flush() -> None:
        nonlocal current
        if current.get("machine"):
            entries.append(current)
        current = {}

    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        data = parse_tokens(parts)
        if not data:
            continue
        # A new "machine" token starts a new record.
        if "machine" in data and current.get("machine"):
            flush()
        current.update(data)
        # Complete one-line records can flush immediately when password seen
        # together with machine on the same line.
        if (
            data.get("machine")
            and data.get("password")
            and (data.get("login") or current.get("login"))
        ):
            flush()
    flush()
    return entries


def candidate_paths() -> list[Path]:
    home = Path.home()
    return [home / ".authinfo", home / ".netrc"]


def list_entries() -> int:
    found = False
    for path in candidate_paths():
        if not path.is_file():
            continue
        found = True
        print(f"# {path}")
        for e in load_entries(path):
            has_pw = "yes" if e.get("password") else "NO"
            print(
                "machine {machine} login {login} port {port} password={has_pw}".format(
                    machine=e.get("machine", "?"),
                    login=e.get("login", "?"),
                    port=e.get("port", "(none)"),
                    has_pw=has_pw,
                )
            )
    if not found:
        print("no ~/.authinfo or ~/.netrc", file=sys.stderr)
        return 1
    return 0


def find_password(machine: str, login: str, port: str | None) -> str | None:
    for path in candidate_paths():
        if not path.is_file():
            continue
        entries = load_entries(path)
        if port is not None:
            for e in entries:
                if (
                    e.get("machine") == machine
                    and e.get("login") == login
                    and e.get("port") == port
                    and e.get("password")
                ):
                    return e["password"]
        for e in entries:
            if (
                e.get("machine") == machine
                and e.get("login") == login
                and e.get("password")
            ):
                return e["password"]
    return None


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] in ("--list", "-l"):
        return list_entries()
    if len(argv) not in (3, 4):
        print(
            "usage: authinfo-pass MACHINE LOGIN [PORT]\n"
            "       authinfo-pass --list",
            file=sys.stderr,
        )
        return 2
    machine, login = argv[1], argv[2]
    port = argv[3] if len(argv) == 4 else None
    password = find_password(machine, login, port)
    if not password:
        print("no matching authinfo entry", file=sys.stderr)
        print("hint: authinfo-pass --list", file=sys.stderr)
        return 1
    sys.stdout.write(password)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
